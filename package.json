{
  "name": "mistlab",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "description": "Curse of Strahd 3D tabletop PWA (iPad-first)",
  "scripts": {
    "dev": "vite",
    "build": "npm run atlas && npm run massing && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "atlas": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/world-atlas.ts",
    "massing": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/world-massing.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node --test scripts/desktop/*.test.mjs",
    "ocr": "bash scripts/ocr.sh",
    "manifests:check": "vitest run tests/manifests.test.ts",
    "books": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/books/build.ts",
    "books:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/books/build.ts --check",
    "terms:review": "node scripts/terms-review.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
